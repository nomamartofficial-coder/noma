generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_EMAIL
  ACTIVE
  RECOVERY_LOCKED
  COMPROMISED_LOCKED
  SUSPENDED
  DEACTIVATION_REQUESTED
  DEACTIVATED

  @@map("account_status")
}

enum CredentialType {
  PASSWORD

  @@map("credential_type")
}

enum SessionStatus {
  ACTIVE
  STEP_UP_REQUIRED
  REVOKED
  EXPIRED

  @@map("session_status")
}

enum AuthenticationAssurance {
  ANONYMOUS
  AUTHENTICATED
  CONTACT_VERIFIED
  RECENTLY_AUTHENTICATED
  MFA_VERIFIED
  PRIVILEGED_MFA_RECENT

  @@map("authentication_assurance")
}

enum MfaFactorStatus {
  PENDING_ENROLLMENT
  ACTIVE
  REPLACED
  REVOKED

  @@map("mfa_factor_status")
}

enum MfaRecoveryBatchStatus {
  ACTIVE
  INVALIDATED

  @@map("mfa_recovery_batch_status")
}

enum StepUpRequirement {
  RECENT_AUTH
  MFA
  MFA_AND_RECENT

  @@map("step_up_requirement")
}

enum MfaMethod {
  TOTP
  RECOVERY_CODE

  @@map("mfa_method")
}

enum IdentityTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RECOVERY

  @@map("identity_token_purpose")
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  PROCESSED
  DEAD_LETTERED

  @@map("outbox_status")
}

enum JobExecutionStatus {
  PROCESSING
  RETRYABLE_FAILURE
  COMPLETED
  DEAD_LETTERED

  @@map("job_execution_status")
}

enum JobAttemptStatus {
  STARTED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  COMPLETED

  @@map("job_attempt_status")
}

enum AttentionOwner {
  OPERATIONS
  FINANCE
  SECURITY

  @@map("attention_owner")
}

enum AttentionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED

  @@map("attention_status")
}

enum EncryptionMigrationStatus {
  PENDING
  RUNNING
  BLOCKED
  COMPLETED

  @@map("encryption_migration_status")
}

enum AccessScopeType {
  SELF
  SELLER
  INSTITUTION
  ORDER
  CASE
  ASSIGNMENT
  FULFILMENT_LOCATION
  QUEUE
  CARRIER
  PLATFORM

  @@map("access_scope_type")
}

enum AccessSubjectType {
  HUMAN
  SERVICE_PRINCIPAL

  @@map("access_subject_type")
}

enum AccessPrivilegeClass {
  ORDINARY
  PRIVILEGED

  @@map("access_privilege_class")
}

enum RoleTemplateStatus {
  DRAFT
  ACTIVE
  RETIRED

  @@map("role_template_status")
}

enum AccessApprovalOperation {
  ASSIGNMENT_GRANT
  ASSIGNMENT_REVOKE
  TEMPORARY_ACCESS_GRANT
  TEMPORARY_ACCESS_REVOKE

  @@map("access_approval_operation")
}

enum AccessApprovalState {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED

  @@map("access_approval_state")
}

enum AccessApprovalDecisionValue {
  APPROVE
  REJECT

  @@map("access_approval_decision_value")
}

enum AuditActorKind {
  HUMAN
  SERVICE_PRINCIPAL
  SYSTEM

  @@map("audit_actor_kind")
}

enum AuditOutcome {
  SUCCEEDED
  DENIED
  FAILED

  @@map("audit_outcome")
}

model EncryptionMigrationRun {
  id                   String                    @id @db.Uuid
  consumerId           String                    @map("consumer_id") @db.VarChar(120)
  environment          String                    @db.VarChar(20)
  sourcePolicyId       String                    @map("source_policy_id") @db.VarChar(160)
  targetPolicyId       String                    @map("target_policy_id") @db.VarChar(160)
  status               EncryptionMigrationStatus @default(PENDING)
  leaseOwner           String?                   @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt       DateTime?                 @map("lease_expires_at") @db.Timestamptz(6)
  cursor               String?                   @db.VarChar(256)
  discoveredCount      BigInt                    @default(0) @map("discovered_count")
  alreadyCurrentCount  BigInt                    @default(0) @map("already_current_count")
  migratedCount        BigInt                    @default(0) @map("migrated_count")
  failedCount          BigInt                    @default(0) @map("failed_count")
  remainingCount       BigInt?                   @map("remaining_count")
  lastFailureCode      String?                   @map("last_failure_code") @db.VarChar(80)
  correlationId        String                    @map("correlation_id") @db.VarChar(160)
  version              Int                       @default(0)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz(6)

  @@index([status, leaseExpiresAt], map: "encryption_migration_runs_claim_idx")
  @@index([consumerId, createdAt], map: "encryption_migration_runs_consumer_idx")
  @@map("encryption_migration_runs")
}

model User {
  id               String            @id @db.Uuid
  publicReference  String            @unique(map: "users_public_reference_key") @map("public_reference") @db.VarChar(32)
  status           AccountStatus     @default(PENDING_EMAIL)
  displayName      String            @map("display_name") @db.VarChar(160)
  locale           String            @default("en-NG") @db.VarChar(35)
  version          Int               @default(0)
  securityVersion  Int               @default(0) @map("security_version")
  lastTransitionAt DateTime          @map("last_transition_at") @db.Timestamptz(6)
  lastTransitionId String            @map("last_transition_id") @db.Uuid
  statusReasonCode String?           @map("status_reason_code") @db.VarChar(80)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deactivatedAt    DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  emails           UserEmail[]
  credentials      Credential[]
  sessions         Session[]
  recoveryAttempts RecoveryAttempt[]
  mfaFactors       MfaFactor[]
  mfaRecoveryCodeBatches MfaRecoveryCodeBatch[]
  selfAccessScopes AccessScope[] @relation("SelfAccessScopeUser")
  roleAssignments RoleAssignment[] @relation("RoleAssignmentUser")
  grantedRoleAssignments RoleAssignment[] @relation("RoleAssignmentGrantor")
  revokedRoleAssignments RoleAssignment[] @relation("RoleAssignmentRevoker")
  ownedServicePrincipals ServicePrincipal[] @relation("ServicePrincipalOwner")
  revokedServicePrincipals ServicePrincipal[] @relation("ServicePrincipalRevoker")
  requestedAccessApprovals ApprovalRequest[] @relation("ApprovalRequestRequestor")
  targetedAccessApprovals ApprovalRequest[] @relation("ApprovalRequestTargetUser")
  accessApprovalDecisions ApprovalDecision[] @relation("ApprovalDecisionApprover")
  ownedTemporaryAccessGrants TemporaryAccessGrant[] @relation("TemporaryAccessOwner")

  @@index([status, createdAt], map: "users_status_created_idx")
  @@map("users")
}

model UserEmail {
  id              String          @id @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  displayEmail    String          @map("display_email") @db.VarChar(320)
  normalizedEmail String          @map("normalized_email") @db.VarChar(320)
  verifiedAt      DateTime?       @map("verified_at") @db.Timestamptz(6)
  primaryAt       DateTime?       @map("primary_at") @db.Timestamptz(6)
  retiredAt       DateTime?       @map("retired_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  identityTokens  IdentityToken[]

  @@index([userId, retiredAt], map: "user_emails_user_retired_idx")
  @@map("user_emails")
}

model Credential {
  id                String         @id @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  type              CredentialType
  encodedHash       String         @map("encoded_hash") @db.Text
  hashAlgorithm     String         @map("hash_algorithm") @db.VarChar(40)
  hashPolicyVersion Int            @map("hash_policy_version")
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  rotatedAt         DateTime?      @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(6)
  user              User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, type, revokedAt], map: "credentials_user_type_revoked_idx")
  @@map("credentials")
}

model Session {
  id                    String                  @id @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  tokenDigest           String                  @unique(map: "sessions_token_digest_key") @map("token_digest") @db.VarChar(128)
  status                SessionStatus           @default(ACTIVE)
  assurance             AuthenticationAssurance
  issuedSecurityVersion Int                     @map("issued_security_version")
  passwordAuthenticatedAt DateTime?             @map("password_authenticated_at") @db.Timestamptz(6)
  mfaVerifiedAt         DateTime?                @map("mfa_verified_at") @db.Timestamptz(6)
  mfaMethod             MfaMethod?               @map("mfa_method")
  mfaFactorId           String?                  @map("mfa_factor_id") @db.Uuid
  issuedAt              DateTime                @map("issued_at") @db.Timestamptz(6)
  lastUsedAt            DateTime                @map("last_used_at") @db.Timestamptz(6)
  idleExpiresAt         DateTime                @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt     DateTime                @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt             DateTime?               @map("revoked_at") @db.Timestamptz(6)
  revocationCode        String?                 @map("revocation_code") @db.VarChar(80)
  deviceLabel           String                  @map("device_label") @db.VarChar(80)
  clientFamily          String?                 @map("client_family") @db.VarChar(80)
  version               Int                     @default(0)
  lastTransitionAt      DateTime                @map("last_transition_at") @db.Timestamptz(6)
  lastTransitionId      String                  @map("last_transition_id") @db.Uuid
  statusReasonCode      String?                 @map("status_reason_code") @db.VarChar(80)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  mfaFactor             MfaFactor?              @relation("SessionMfaFactor", fields: [mfaFactorId], references: [id], onDelete: Restrict)
  stepUpChallenges      SessionStepUpChallenge[]

  @@index([userId, status, absoluteExpiresAt], map: "sessions_user_status_expiry_idx")
  @@map("sessions")
}

model MfaFactor {
  id                       String          @id @db.Uuid
  userId                   String          @map("user_id") @db.Uuid
  status                   MfaFactorStatus
  encryptedSeedEnvelope    Json            @map("encrypted_seed_envelope") @db.JsonB
  algorithm                String          @db.VarChar(16)
  digits                   Int
  periodSeconds            Int             @map("period_seconds")
  lastAcceptedTimeStep     BigInt?         @map("last_accepted_time_step")
  enrollmentExpiresAt      DateTime        @map("enrollment_expires_at") @db.Timestamptz(6)
  activatedAt              DateTime?       @map("activated_at") @db.Timestamptz(6)
  replacedAt               DateTime?       @map("replaced_at") @db.Timestamptz(6)
  revokedAt                DateTime?       @map("revoked_at") @db.Timestamptz(6)
  version                  Int             @default(0)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                     User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryBatches          MfaRecoveryCodeBatch[]
  proofSessions            Session[]              @relation("SessionMfaFactor")
  proofChallenges          SessionStepUpChallenge[] @relation("ChallengeMfaFactor")

  @@index([userId, status], map: "mfa_factors_user_status_idx")
  @@map("mfa_factors")
}

model MfaRecoveryCodeBatch {
  id             String                 @id @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  factorId       String                 @map("factor_id") @db.Uuid
  status         MfaRecoveryBatchStatus
  issuedAt       DateTime               @map("issued_at") @db.Timestamptz(6)
  invalidatedAt  DateTime?              @map("invalidated_at") @db.Timestamptz(6)
  version        Int                    @default(0)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  factor         MfaFactor              @relation(fields: [factorId], references: [id], onDelete: Restrict)
  codes          MfaRecoveryCode[]

  @@index([factorId, status], map: "mfa_recovery_batches_factor_status_idx")
  @@map("mfa_recovery_code_batches")
}

model MfaRecoveryCode {
  id             String               @id @db.Uuid
  batchId        String               @map("batch_id") @db.Uuid
  codeDigest     String               @unique(map: "mfa_recovery_codes_digest_key") @map("code_digest") @db.VarChar(128)
  consumedAt     DateTime?            @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt  DateTime?            @map("invalidated_at") @db.Timestamptz(6)
  version        Int                  @default(0)
  batch          MfaRecoveryCodeBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([batchId, consumedAt, invalidatedAt], map: "mfa_recovery_codes_usable_idx")
  @@map("mfa_recovery_codes")
}

model SessionStepUpChallenge {
  id                    String            @id @db.Uuid
  sessionId             String            @map("session_id") @db.Uuid
  requirement           StepUpRequirement
  contextCode           String            @map("context_code") @db.VarChar(80)
  issuedSecurityVersion Int               @map("issued_security_version")
  passwordProvenAt      DateTime?         @map("password_proven_at") @db.Timestamptz(6)
  mfaProvenAt           DateTime?         @map("mfa_proven_at") @db.Timestamptz(6)
  mfaMethod             MfaMethod?        @map("mfa_method")
  mfaFactorId           String?           @map("mfa_factor_id") @db.Uuid
  issuedAt              DateTime          @map("issued_at") @db.Timestamptz(6)
  expiresAt             DateTime          @map("expires_at") @db.Timestamptz(6)
  completedAt           DateTime?         @map("completed_at") @db.Timestamptz(6)
  invalidatedAt         DateTime?         @map("invalidated_at") @db.Timestamptz(6)
  version               Int               @default(0)
  session               Session           @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  mfaFactor             MfaFactor?        @relation("ChallengeMfaFactor", fields: [mfaFactorId], references: [id], onDelete: Restrict)

  @@index([sessionId, expiresAt], map: "session_step_up_challenges_session_expiry_idx")
  @@map("session_step_up_challenges")
}

model IdentityToken {
  id                    String               @id @db.Uuid
  userEmailId           String               @map("user_email_id") @db.Uuid
  purpose               IdentityTokenPurpose
  tokenDigest           String               @unique(map: "identity_tokens_token_digest_key") @map("token_digest") @db.VarChar(128)
  issuedSecurityVersion Int                  @map("issued_security_version")
  issuedAt              DateTime             @map("issued_at") @db.Timestamptz(6)
  expiresAt             DateTime             @map("expires_at") @db.Timestamptz(6)
  consumedAt            DateTime?            @map("consumed_at") @db.Timestamptz(6)
  invalidatedAt         DateTime?            @map("invalidated_at") @db.Timestamptz(6)
  invalidationCode      String?              @map("invalidation_code") @db.VarChar(80)
  replacedByTokenId     String?              @map("replaced_by_token_id") @db.Uuid
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  userEmail             UserEmail            @relation(fields: [userEmailId], references: [id], onDelete: Restrict)
  replacedBy            IdentityToken?       @relation("IdentityTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replaces              IdentityToken[]      @relation("IdentityTokenReplacement")

  @@index([userEmailId, purpose, expiresAt], map: "identity_tokens_subject_purpose_expiry_idx")
  @@map("identity_tokens")
}

model RecoveryAttempt {
  id                    String   @id @db.Uuid
  userId                String?  @map("user_id") @db.Uuid
  subjectDigest         String   @map("subject_digest") @db.VarChar(128)
  correlationId         String   @map("correlation_id") @db.VarChar(200)
  methodCode            String   @map("method_code") @db.VarChar(80)
  outcomeCode           String   @map("outcome_code") @db.VarChar(80)
  assuranceEvidenceCode String?  @map("assurance_evidence_code") @db.VarChar(80)
  containmentCode       String?  @map("containment_code") @db.VarChar(80)
  occurredAt            DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([subjectDigest, occurredAt], map: "recovery_attempts_subject_time_idx")
  @@index([userId, occurredAt], map: "recovery_attempts_user_time_idx")
  @@map("recovery_attempts")
}

model AccessScope {
  id                       String          @id @db.Uuid
  type                     AccessScopeType
  userId                   String?         @map("user_id") @db.Uuid
  resourceId               String?         @map("resource_id") @db.Uuid
  parentInstitutionScopeId String?         @map("parent_institution_scope_id") @db.Uuid
  retiredAt                DateTime?       @map("retired_at") @db.Timestamptz(6)
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User?           @relation("SelfAccessScopeUser", fields: [userId], references: [id], onDelete: Restrict)
  parentInstitutionScope   AccessScope?    @relation("InstitutionScopeChildren", fields: [parentInstitutionScopeId], references: [id], onDelete: Restrict)
  childScopes              AccessScope[]   @relation("InstitutionScopeChildren")
  assignments              RoleAssignment[]
  approvalRequests         ApprovalRequest[]

  @@unique([type, resourceId], map: "access_scopes_type_resource_key")
  @@index([parentInstitutionScopeId, type], map: "access_scopes_parent_type_idx")
  @@map("access_scopes")
}

model Capability {
  id                   String                   @id @db.Uuid
  code                 String                   @unique(map: "capabilities_code_key") @db.VarChar(120)
  description          String                   @db.VarChar(240)
  retiredAt            DateTime?                @map("retired_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  roleTemplateMappings RoleTemplateCapability[]

  @@map("capabilities")
}

model RoleTemplate {
  id                         String                       @id @db.Uuid
  code                       String                       @db.VarChar(80)
  version                    Int
  displayName                String                       @map("display_name") @db.VarChar(120)
  status                     RoleTemplateStatus           @default(DRAFT)
  privilegeClass             AccessPrivilegeClass         @map("privilege_class")
  requireContactVerified     Boolean                      @default(false) @map("require_contact_verified")
  passwordMaxAgeMilliseconds Int?                         @map("password_max_age_milliseconds")
  mfaMaxAgeMilliseconds      Int?                         @map("mfa_max_age_milliseconds")
  activatedAt                DateTime?                    @map("activated_at") @db.Timestamptz(6)
  retiredAt                  DateTime?                    @map("retired_at") @db.Timestamptz(6)
  createdAt                  DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  allowedScopes              RoleTemplateAllowedScope[]
  allowedSubjects            RoleTemplateAllowedSubject[]
  capabilities               RoleTemplateCapability[]
  assignments                RoleAssignment[]
  approvalRequests           ApprovalRequest[]

  @@unique([code, version], map: "role_templates_code_version_key")
  @@index([status, code], map: "role_templates_status_code_idx")
  @@map("role_templates")
}

model RoleTemplateAllowedScope {
  roleTemplateId String          @map("role_template_id") @db.Uuid
  scopeType      AccessScopeType @map("scope_type")
  roleTemplate  RoleTemplate    @relation(fields: [roleTemplateId], references: [id], onDelete: Restrict)

  @@id([roleTemplateId, scopeType])
  @@map("role_template_allowed_scopes")
}

model RoleTemplateAllowedSubject {
  roleTemplateId String            @map("role_template_id") @db.Uuid
  subjectType     AccessSubjectType @map("subject_type")
  roleTemplate   RoleTemplate      @relation(fields: [roleTemplateId], references: [id], onDelete: Restrict)

  @@id([roleTemplateId, subjectType])
  @@map("role_template_allowed_subjects")
}

model RoleTemplateCapability {
  roleTemplateId String       @map("role_template_id") @db.Uuid
  capabilityId   String       @map("capability_id") @db.Uuid
  roleTemplate   RoleTemplate @relation(fields: [roleTemplateId], references: [id], onDelete: Restrict)
  capability     Capability   @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@id([roleTemplateId, capabilityId])
  @@map("role_template_capabilities")
}

model RoleAssignment {
  id                     String            @id @db.Uuid
  subjectType            AccessSubjectType @map("subject_type")
  userId                 String?           @map("user_id") @db.Uuid
  servicePrincipalId     String?           @map("service_principal_id") @db.Uuid
  roleTemplateId         String            @map("role_template_id") @db.Uuid
  scopeId                String            @map("scope_id") @db.Uuid
  scopeType              AccessScopeType   @map("scope_type")
  validFrom              DateTime          @map("valid_from") @db.Timestamptz(6)
  validUntil             DateTime?         @map("valid_until") @db.Timestamptz(6)
  grantedByUserId        String            @map("granted_by_user_id") @db.Uuid
  grantReason            String            @map("grant_reason") @db.VarChar(500)
  grantedAt              DateTime          @map("granted_at") @db.Timestamptz(6)
  revokedByUserId        String?           @map("revoked_by_user_id") @db.Uuid
  revocationReason       String?           @map("revocation_reason") @db.VarChar(500)
  revokedAt              DateTime?         @map("revoked_at") @db.Timestamptz(6)
  version                Int               @default(0)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User?             @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Restrict)
  servicePrincipal       ServicePrincipal? @relation(fields: [servicePrincipalId], references: [id], onDelete: Restrict)
  roleTemplate           RoleTemplate      @relation(fields: [roleTemplateId], references: [id], onDelete: Restrict)
  scope                  AccessScope       @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  grantedByUser          User              @relation("RoleAssignmentGrantor", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedByUser          User?             @relation("RoleAssignmentRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  temporaryAccessGrant   TemporaryAccessGrant?

  @@index([userId, validFrom, validUntil], map: "role_assignments_user_validity_idx")
  @@index([servicePrincipalId, validFrom, validUntil], map: "role_assignments_service_validity_idx")
  @@index([scopeId, validFrom, validUntil], map: "role_assignments_scope_validity_idx")
  @@map("role_assignments")
}

model ApprovalRequest {
  id                          String                  @id @db.Uuid
  operation                   AccessApprovalOperation
  subjectType                 AccessSubjectType       @map("subject_type")
  targetUserId                String?                 @map("target_user_id") @db.Uuid
  targetServicePrincipalId    String?                 @map("target_service_principal_id") @db.Uuid
  roleTemplateId              String                  @map("role_template_id") @db.Uuid
  scopeId                     String                  @map("scope_id") @db.Uuid
  scopeType                   AccessScopeType         @map("scope_type")
  requestedValidFrom          DateTime                @map("requested_valid_from") @db.Timestamptz(6)
  requestedValidUntil         DateTime?               @map("requested_valid_until") @db.Timestamptz(6)
  requestedByUserId           String                  @map("requested_by_user_id") @db.Uuid
  reason                      String                  @db.VarChar(500)
  expiresAt                   DateTime                @map("expires_at") @db.Timestamptz(6)
  idempotencyKey              String                  @map("idempotency_key") @db.VarChar(160)
  independentApprovalRequired Boolean                 @map("independent_approval_required")
  state                       AccessApprovalState     @default(PENDING)
  version                     Int                     @default(0)
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  targetUser                  User?                   @relation("ApprovalRequestTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetServicePrincipal      ServicePrincipal?       @relation(fields: [targetServicePrincipalId], references: [id], onDelete: Restrict)
  roleTemplate                RoleTemplate            @relation(fields: [roleTemplateId], references: [id], onDelete: Restrict)
  scope                       AccessScope             @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  requestedByUser             User                    @relation("ApprovalRequestRequestor", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decisions                   ApprovalDecision[]
  temporaryAccessGrants       TemporaryAccessGrant[]

  @@unique([requestedByUserId, idempotencyKey], map: "approval_requests_requestor_idempotency_key")
  @@index([state, expiresAt], map: "approval_requests_state_expiry_idx")
  @@map("approval_requests")
}

model ApprovalDecision {
  id                      String                      @id @db.Uuid
  approvalRequestId       String                      @map("approval_request_id") @db.Uuid
  approverUserId          String                      @map("approver_user_id") @db.Uuid
  decision                AccessApprovalDecisionValue
  reason                  String                      @db.VarChar(500)
  decidedAt               DateTime                    @map("decided_at") @db.Timestamptz(6)
  sessionId               String                      @map("session_id") @db.Uuid
  securityVersion         Int                         @map("security_version")
  passwordAuthenticatedAt DateTime?                   @map("password_authenticated_at") @db.Timestamptz(6)
  mfaVerifiedAt           DateTime?                   @map("mfa_verified_at") @db.Timestamptz(6)
  mfaMethod               MfaMethod?                  @map("mfa_method")
  mfaFactorId             String?                     @map("mfa_factor_id") @db.Uuid
  assuranceEvaluatedAt    DateTime                    @map("assurance_evaluated_at") @db.Timestamptz(6)
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  approvalRequest         ApprovalRequest             @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)
  approverUser            User                        @relation("ApprovalDecisionApprover", fields: [approverUserId], references: [id], onDelete: Restrict)

  @@unique([approvalRequestId, approverUserId], map: "approval_decisions_request_approver_key")
  @@index([approverUserId, decidedAt], map: "approval_decisions_approver_time_idx")
  @@map("approval_decisions")
}

model TemporaryAccessGrant {
  id                String          @id @db.Uuid
  roleAssignmentId  String          @unique(map: "temporary_access_grants_assignment_key") @map("role_assignment_id") @db.Uuid
  ownerUserId       String          @map("owner_user_id") @db.Uuid
  reason            String          @db.VarChar(500)
  approvalRequestId String?         @map("approval_request_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  roleAssignment    RoleAssignment  @relation(fields: [roleAssignmentId], references: [id], onDelete: Restrict)
  ownerUser         User            @relation("TemporaryAccessOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  @@map("temporary_access_grants")
}

model ServicePrincipal {
  id                      String            @id @db.Uuid
  environment             String            @db.VarChar(20)
  code                    String            @db.VarChar(100)
  purpose                 String            @db.VarChar(240)
  ownerUserId             String            @map("owner_user_id") @db.Uuid
  credentialPolicyVersion Int               @map("credential_policy_version")
  lastRotatedAt           DateTime?         @map("last_rotated_at") @db.Timestamptz(6)
  revokedAt               DateTime?         @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId         String?           @map("revoked_by_user_id") @db.Uuid
  revocationReason        String?           @map("revocation_reason") @db.VarChar(500)
  version                 Int               @default(0)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  ownerUser               User              @relation("ServicePrincipalOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  revokedByUser           User?             @relation("ServicePrincipalRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  roleAssignments         RoleAssignment[]
  approvalRequests        ApprovalRequest[]

  @@unique([environment, code], map: "service_principals_environment_code_key")
  @@index([ownerUserId, revokedAt], map: "service_principals_owner_revoked_idx")
  @@map("service_principals")
}

model AuditEvent {
  id                           String                  @id @db.Uuid
  recordedSequence             BigInt                  @unique(map: "audit_events_recorded_sequence_key") @default(autoincrement()) @map("recorded_sequence")
  actionCode                   String                  @map("action_code") @db.VarChar(120)
  contractVersion              Int                     @map("contract_version")
  sourceModule                 String                  @map("source_module") @db.VarChar(80)
  occurredAt                   DateTime                @map("occurred_at") @db.Timestamptz(6)
  recordedAt                   DateTime                @default(now()) @map("recorded_at") @db.Timestamptz(6)
  actorKind                    AuditActorKind          @map("actor_kind")
  actorUserId                  String?                 @map("actor_user_id") @db.Uuid
  actorServicePrincipalId      String?                 @map("actor_service_principal_id") @db.Uuid
  systemActorCode              String?                 @map("system_actor_code") @db.VarChar(120)
  sessionId                    String?                 @map("session_id") @db.Uuid
  authorityRoleAssignmentId    String?                 @map("authority_role_assignment_id") @db.Uuid
  authorityRoleTemplateCode    String?                 @map("authority_role_template_code") @db.VarChar(80)
  authorityRoleTemplateVersion Int?                    @map("authority_role_template_version")
  authorityCapabilityCode      String?                 @map("authority_capability_code") @db.VarChar(120)
  authorityPolicyId            String?                 @map("authority_policy_id") @db.VarChar(160)
  authorityScopeType           AccessScopeType?        @map("authority_scope_type")
  authorityScopeId             String?                 @map("authority_scope_id") @db.Uuid
  institutionId                String?                 @map("institution_id") @db.Uuid
  assurance                    AuthenticationAssurance?
  approvalRequestId            String?                 @map("approval_request_id") @db.Uuid
  resourceType                 String                  @map("resource_type") @db.VarChar(80)
  resourceId                   String                  @map("resource_id") @db.VarChar(200)
  reasonCode                   String?                 @map("reason_code") @db.VarChar(80)
  reasonText                   String?                 @map("reason_text") @db.VarChar(500)
  outcome                      AuditOutcome
  failureCode                  String?                 @map("failure_code") @db.VarChar(120)
  requestId                    String?                 @map("request_id") @db.VarChar(200)
  correlationId               String                  @map("correlation_id") @db.VarChar(200)
  operationId                 String                  @map("operation_id") @db.VarChar(200)
  sourceVersion               BigInt?                 @map("source_version")
  beforeSummary               Json?                   @map("before_summary") @db.JsonB
  afterSummary                Json?                   @map("after_summary") @db.JsonB
  correctsAuditEventId         String?                 @map("corrects_audit_event_id") @db.Uuid
  correctsAuditEvent           AuditEvent?             @relation("AuditEventCorrections", fields: [correctsAuditEventId], references: [id], onDelete: Restrict)
  corrections                  AuditEvent[]            @relation("AuditEventCorrections")
  links                        AuditEventLink[]

  @@unique([sourceModule, actionCode, operationId], map: "audit_events_operation_key")
  @@index([resourceType, resourceId, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_resource_timeline_idx")
  @@index([actorUserId, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_human_actor_timeline_idx")
  @@index([actorServicePrincipalId, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_service_actor_timeline_idx")
  @@index([institutionId, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_institution_timeline_idx")
  @@index([correlationId, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_correlation_timeline_idx")
  @@index([actionCode, recordedSequence(sort: Desc), id(sort: Desc)], map: "audit_events_action_timeline_idx")
  @@index([recordedAt(sort: Desc), recordedSequence(sort: Desc)], map: "audit_events_recorded_time_idx")
  @@map("audit_events")
}

model AuditEventLink {
  auditEventId     String     @map("audit_event_id") @db.Uuid
  targetType       String     @map("target_type") @db.VarChar(80)
  targetId         String     @map("target_id") @db.VarChar(200)
  relationshipType String     @map("relationship_type") @db.VarChar(80)
  auditEvent       AuditEvent @relation(fields: [auditEventId], references: [id], onDelete: Restrict)

  @@id([auditEventId, targetType, targetId])
  @@index([targetType, targetId, auditEventId], map: "audit_event_links_target_idx")
  @@map("audit_event_links")
}

model OutboxEvent {
  id                    String           @id @db.Uuid
  eventType             String           @map("event_type") @db.VarChar(160)
  eventVersion          Int              @map("event_version")
  queueName             String           @map("queue_name") @db.VarChar(80)
  jobName               String           @map("job_name") @db.VarChar(160)
  jobVersion            Int              @map("job_version")
  aggregateType         String           @map("aggregate_type") @db.VarChar(100)
  aggregateId           String           @map("aggregate_id") @db.VarChar(200)
  aggregateVersion      BigInt           @map("aggregate_version")
  institutionId         String?          @map("institution_id") @db.Uuid
  scopeType             String?          @map("scope_type") @db.VarChar(80)
  scopeId               String?          @map("scope_id") @db.VarChar(200)
  payload               Json             @db.JsonB
  privacyClassification String           @map("privacy_classification") @db.VarChar(40)
  servicePrincipal      String           @map("service_principal") @db.VarChar(120)
  correlationId         String           @map("correlation_id") @db.VarChar(200)
  occurredAt            DateTime         @map("occurred_at") @db.Timestamptz(6)
  availableAt           DateTime         @map("available_at") @db.Timestamptz(6)
  status                OutboxStatus     @default(PENDING)
  leaseOwner            String?          @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt        DateTime?        @map("lease_expires_at") @db.Timestamptz(6)
  dispatchAttempts      Int              @default(0) @map("dispatch_attempts")
  dispatchedAt          DateTime?        @map("dispatched_at") @db.Timestamptz(6)
  processedAt           DateTime?        @map("processed_at") @db.Timestamptz(6)
  deadLetteredAt        DateTime?        @map("dead_lettered_at") @db.Timestamptz(6)
  attentionOwner        AttentionOwner?  @map("attention_owner")
  attentionStatus       AttentionStatus? @map("attention_status")
  attentionDeadlineAt   DateTime?        @map("attention_deadline_at") @db.Timestamptz(6)
  recoveryAction        String?          @map("recovery_action") @db.VarChar(80)
  lastFailureCode       String?          @map("last_failure_code") @db.VarChar(120)
  lastFailureMessage    String?          @map("last_failure_message") @db.VarChar(500)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobExecutions         JobExecution[]

  @@index([aggregateType, aggregateId, aggregateVersion], map: "outbox_events_aggregate_idx")
  @@map("outbox_events")
}

model JobExecution {
  id                  String             @id @db.Uuid
  outboxEventId       String?            @map("outbox_event_id") @db.Uuid
  queueName           String             @map("queue_name") @db.VarChar(80)
  jobId               String             @map("job_id") @db.VarChar(200)
  jobName             String             @map("job_name") @db.VarChar(160)
  jobVersion          Int                @map("job_version")
  aggregateVersion    BigInt             @map("aggregate_version")
  status              JobExecutionStatus
  attemptCount        Int                @default(0) @map("attempt_count")
  leaseOwner          String?            @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt      DateTime?          @map("lease_expires_at") @db.Timestamptz(6)
  servicePrincipal    String             @map("service_principal") @db.VarChar(120)
  correlationId       String             @map("correlation_id") @db.VarChar(200)
  startedAt           DateTime?          @map("started_at") @db.Timestamptz(6)
  completedAt         DateTime?          @map("completed_at") @db.Timestamptz(6)
  deadLetteredAt      DateTime?          @map("dead_lettered_at") @db.Timestamptz(6)
  attentionOwner      AttentionOwner?    @map("attention_owner")
  attentionStatus     AttentionStatus?   @map("attention_status")
  attentionDeadlineAt DateTime?          @map("attention_deadline_at") @db.Timestamptz(6)
  recoveryAction      String?            @map("recovery_action") @db.VarChar(80)
  lastFailureCode     String?            @map("last_failure_code") @db.VarChar(120)
  lastFailureMessage  String?            @map("last_failure_message") @db.VarChar(500)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  outboxEvent         OutboxEvent?       @relation(fields: [outboxEventId], references: [id], onDelete: Restrict)
  attempts            JobExecutionAttempt[]

  @@unique([queueName, jobId], map: "job_executions_queue_job_key")
  @@index([outboxEventId], map: "job_executions_outbox_event_idx")
  @@map("job_executions")
}

model JobExecutionAttempt {
  id                 BigInt           @id @default(autoincrement())
  jobExecutionId     String           @map("job_execution_id") @db.Uuid
  attemptNumber      Int              @map("attempt_number")
  status             JobAttemptStatus
  workerIdentity     String           @map("worker_identity") @db.VarChar(160)
  startedAt          DateTime         @map("started_at") @db.Timestamptz(6)
  finishedAt         DateTime?        @map("finished_at") @db.Timestamptz(6)
  failureCode        String?          @map("failure_code") @db.VarChar(120)
  failureMessage     String?          @map("failure_message") @db.VarChar(500)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  jobExecution       JobExecution     @relation(fields: [jobExecutionId], references: [id], onDelete: Restrict)

  @@unique([jobExecutionId, attemptNumber], map: "job_execution_attempts_execution_attempt_key")
  @@index([jobExecutionId, createdAt], map: "job_execution_attempts_history_idx")
  @@map("job_execution_attempts")
}
