{
  "name": "@noma/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persistence boundary and transaction/repository contracts.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs . src/generated/prisma",
    "typecheck": "pnpm db:generate && node ../../scripts/run-tsc.mjs --noEmit",
    "build": "pnpm db:generate && node ../../scripts/run-tsc.mjs",
    "clean": "node ../../scripts/clean-package.mjs . src/generated/prisma",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/database/tests",
    "db:validate": "prisma validate",
    "db:generate": "node ../../scripts/run-prisma-generate.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@noma/contracts": "workspace:*",
    "@noma/platform": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "prisma": "7.9.1"
  }
}
