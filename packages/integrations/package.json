{
  "name": "@noma/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider adapter boundary implementing platform ports.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/integrations/tests",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "dependencies": {
    "@noma/contracts": "workspace:*",
    "@noma/observability": "workspace:*",
    "@noma/platform": "workspace:*",
    "bullmq": "5.81.2",
    "ioredis": "5.11.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  }
}
