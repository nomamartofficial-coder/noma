{
  "name": "@noma/security",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Security policy, redaction, and authorization support contracts.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  },
  "dependencies": {
    "@noma/contracts": "workspace:*",
    "@noma/platform": "workspace:*",
    "@zxcvbn-ts/language-common": "4.1.3",
    "argon2": "0.45.1",
    "otpauth": "9.5.2"
  }
}
