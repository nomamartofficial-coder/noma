{
  "name": "@noma/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-safe design tokens and accessible UI primitives.",
  "sideEffects": [
    "./dist/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./foundations.css": "./dist/foundations.css",
    "./components.css": "./dist/components.css",
    "./commerce.css": "./dist/commerce.css"
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs && node ../../scripts/generate-ui-token-css.mjs",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/ui/tests && pnpm --dir ../.. exec vitest run --config vitest.config.ts --project component tests/component/ui-primitives.component.test.tsx tests/component/ui-commerce.component.test.tsx",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
