{
  "name": "@noma/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed public/server environment validation, isolation, safe diagnostics, and test overrides.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./public": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/config/tests",
    "clean": "node ../../scripts/clean-package.mjs ."
  }
}
