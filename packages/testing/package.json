{
  "name": "@noma/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic fixtures and test-harness public contracts.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./containers": {
      "types": "./dist/containers.d.ts",
      "default": "./dist/containers.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "default": "./dist/providers.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "test": "pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/testing/tests",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "dependencies": {
    "@noma/contracts": "workspace:*",
    "@noma/integrations": "workspace:*",
    "@noma/platform": "workspace:*",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "testcontainers": "12.0.4"
  }
}
