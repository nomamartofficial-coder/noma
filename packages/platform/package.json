{
  "name": "@noma/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain/application public interfaces and declared ports.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "default": "./dist/providers/index.js"
    },
    "./identity": {
      "types": "./dist/identity/index.d.ts",
      "default": "./dist/identity/index.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./audit": {
      "types": "./dist/audit/index.d.ts",
      "default": "./dist/audit/index.js"
    },
    "./privacy": {
      "types": "./dist/privacy/index.d.ts",
      "default": "./dist/privacy/index.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "dependencies": {
    "@noma/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  }
}
