{
  "name": "@noma/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Client-safe and server-only observability contracts.",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "node ../../scripts/run-tsc.mjs --noEmit",
    "build": "node ../../scripts/run-tsc.mjs",
    "test": "pnpm build && pnpm --dir ../.. exec vitest run --config vitest.config.ts --project unit packages/observability/tests",
    "clean": "node ../../scripts/clean-package.mjs ."
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  }
}
