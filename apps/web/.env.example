# Browser-exposed values. Never add secrets to NEXT_PUBLIC_* variables.
NEXT_PUBLIC_NOMA_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Server-only, non-secret Access Admin transport values. Preview requires exact
# approved HTTPS origins; see DEPLOYMENT.md before configuring that environment.
NOMA_ENV=development
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001
