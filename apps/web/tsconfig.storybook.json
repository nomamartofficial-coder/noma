{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "vitest.storybook.config.ts",
    "playwright.visual.config.ts"
  ],
  "exclude": ["node_modules", "storybook-static", "test-results"]
}
