{
  "name": "@noma/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noma Next.js App Router runtime scaffold.",
  "dependencies": {
    "@noma/config": "workspace:*",
    "@noma/contracts": "workspace:*",
    "@noma/observability": "workspace:*",
    "@noma/ui": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "mockdate": "3.0.5",
    "storybook": "10.5.10",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "tsc --noEmit",
    "build": "next build && node ../../scripts/verify-ui-token-build.mjs",
    "clean": "node ../../scripts/clean-package.mjs . && node -e \"import('node:fs/promises').then(fs=>fs.rm('.next',{recursive:true,force:true}))\"",
    "dev": "next dev",
    "start": "next start"
  }
}
