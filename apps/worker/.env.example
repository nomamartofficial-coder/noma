# Local defaults are safe; production-critical values are intentionally omitted.
NOMA_ENV=development
NOMA_PROVIDER_MODE=disabled
NOMA_CREDENTIAL_ENVIRONMENT=development
HOST=127.0.0.1
WORKER_PORT=3002
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001

# Staging and production require DATABASE_URL, REDIS_URL, and NOMA_RELEASE_SHA.
# Worker does not receive SESSION_SECRET because it does not own browser sessions.
# from approved environment secret management. Do not put real values in this file.
