# Local defaults are safe; production-critical values are intentionally omitted.
NOMA_ENV=development
NOMA_PROVIDER_MODE=disabled
NOMA_TELEMETRY_MODE=disabled
NOMA_CREDENTIAL_ENVIRONMENT=development
HOST=127.0.0.1
API_PORT=3001
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001

# Configuring API authentication requires AUTH_CORRELATION_SECRET, DATABASE_URL,
# and REDIS_URL together. Remote policy separately requires SESSION_SECRET and NOMA_RELEASE_SHA.
# Optional reviewed session policy: NOMA_AUTH_IDLE_MS, NOMA_AUTH_ABSOLUTE_MS,
# and NOMA_AUTH_TOUCH_AFTER_MS. Never put real values here.
# OTLP export requires a reviewed HTTPS endpoint, an explicit sample ratio from 0 through 1,
# and secret authorization from approved environment management.
