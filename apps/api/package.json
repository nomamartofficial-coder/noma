{
  "name": "@noma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noma NestJS HTTP API runtime scaffold.",
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@noma/config": "workspace:*",
    "@noma/contracts": "workspace:*",
    "@noma/database": "workspace:*",
    "@noma/integrations": "workspace:*",
    "@noma/observability": "workspace:*",
    "@noma/platform": "workspace:*",
    "@noma/security": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.12.4"
  },
  "scripts": {
    "lint": "node ../../scripts/lint-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node ../../scripts/clean-package.mjs .",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  }
}
