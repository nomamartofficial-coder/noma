{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noma.local/schemas/ci-evidence-manifest.schema.json",
  "title": "Noma CI evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "task_ids",
    "requirement_ids",
    "risk_class",
    "repository",
    "commit_sha",
    "ref",
    "pull_request_number",
    "event_type",
    "workflow_name",
    "workflow_run_id",
    "workflow_run_attempt",
    "workflow_run_url",
    "suite",
    "segment",
    "job_name",
    "job_result",
    "environment",
    "provider_environment",
    "runner",
    "toolchain",
    "lockfile_sha256",
    "test_seed",
    "started_at",
    "completed_at",
    "commands",
    "coverage",
    "migrations",
    "container_images",
    "traceability",
    "artifact_names",
    "retention_days",
    "contains_personal_data",
    "contains_secrets",
    "redaction_review",
    "known_limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "evidence_id": { "type": "string", "minLength": 8 },
    "task_ids": { "type": "array", "items": { "type": "string" } },
    "requirement_ids": { "type": "array", "items": { "type": "string" } },
    "risk_class": { "const": "P0-RECOVERY" },
    "repository": { "type": "string" },
    "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "ref": { "type": "string" },
    "pull_request_number": { "type": ["integer", "null"] },
    "event_type": { "type": "string" },
    "workflow_name": { "type": "string" },
    "workflow_run_id": { "type": ["string", "null"] },
    "workflow_run_attempt": { "type": ["integer", "null"] },
    "workflow_run_url": { "type": ["string", "null"] },
    "suite": { "type": "string" },
    "segment": { "type": "string" },
    "job_name": { "type": "string" },
    "job_result": { "enum": ["success", "failure", "cancelled", "skipped"] },
    "environment": { "enum": ["github-hosted-ci", "local-development"] },
    "provider_environment": { "const": "disabled" },
    "runner": { "type": "object" },
    "toolchain": { "type": "object" },
    "lockfile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "test_seed": { "type": "string" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "commands": { "type": "array", "minItems": 1 },
    "coverage": { "type": "object" },
    "migrations": { "type": "object" },
    "container_images": { "type": "object" },
    "traceability": { "type": "object" },
    "artifact_names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "retention_days": { "const": 90 },
    "contains_personal_data": { "const": false },
    "contains_secrets": { "const": false },
    "redaction_review": { "const": "PASS" },
    "known_limitations": { "type": "array", "items": { "type": "string" } }
  }
}

