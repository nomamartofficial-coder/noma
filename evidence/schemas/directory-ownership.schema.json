{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noma.local/schemas/directory-ownership.schema.json",
  "title": "Noma governed directory ownership registry",
  "type": "object",
  "required": [
    "schema_version",
    "updated_at",
    "directories"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "directories": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": [
          "path",
          "primary_owner_role",
          "reviewer_roles",
          "approval_roles",
          "review_cadence",
          "classification",
          "personal_data_allowed",
          "secrets_allowed",
          "expiry_required"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "quality/",
              "compliance/",
              "security/",
              "runbooks/",
              "evidence/",
              "change-control/"
            ]
          },
          "primary_owner_role": {
            "type": "string",
            "minLength": 2
          },
          "reviewer_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "approval_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "review_cadence": {
            "type": "string",
            "minLength": 3
          },
          "classification": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "INTERNAL_METADATA_ONLY",
              "RESTRICTED_METADATA_ONLY"
            ]
          },
          "personal_data_allowed": {
            "const": false
          },
          "secrets_allowed": {
            "const": false
          },
          "expiry_required": {
            "const": true
          }
        }
      }
    }
  }
}
