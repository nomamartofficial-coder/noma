{
  "name": "noma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noma Covenant pilot workspace monorepo",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "workspace:validate": "node scripts/validate-workspace.mjs",
    "workspace:self-test": "node scripts/validate-workspace.mjs --self-test",
    "runtimes:validate": "node scripts/validate-runtime-scaffolds.mjs",
    "runtimes:self-test": "node scripts/validate-runtime-scaffolds.mjs --self-test",
    "env:validate": "node scripts/validate-environment-config.mjs",
    "env:self-test": "node scripts/validate-environment-config.mjs --self-test",
    "env:test": "pnpm --filter @noma/config build && pnpm --filter @noma/config test",
    "env:startup-test": "pnpm build && node scripts/test-environment-startup.mjs",
    "env:verify": "pnpm env:validate && pnpm env:self-test && pnpm env:test && pnpm env:startup-test",
    "db:foundation:validate": "node scripts/validate-database-foundation.mjs",
    "db:self-test": "node scripts/validate-database-foundation.mjs --self-test",
    "db:validate": "pnpm db:foundation:validate && pnpm --filter @noma/database db:validate",
    "db:generate": "pnpm --filter @noma/database db:generate",
    "db:migrate:dev": "pnpm --filter @noma/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @noma/database db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @noma/database db:migrate:status",
    "db:reset:local": "node scripts/reset-database.mjs",
    "db:test": "pnpm --filter @noma/database test",
    "db:migration-test": "node scripts/test-database-migrations.mjs",
    "db:verify": "pnpm db:validate && pnpm db:self-test && pnpm db:generate && pnpm db:test && pnpm db:migration-test",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "queue:foundation:validate": "node scripts/validate-queue-foundation.mjs",
    "queue:self-test": "node scripts/validate-queue-foundation.mjs --self-test",
    "queue:test": "pnpm --filter @noma/contracts test && pnpm --filter @noma/integrations test && pnpm --filter @noma/worker test",
    "queue:integration-test": "pnpm build && node scripts/test-queue-foundation.mjs",
    "queue:verify": "pnpm queue:foundation:validate && pnpm queue:self-test && pnpm queue:test && pnpm queue:integration-test",
    "queue:up": "docker compose up -d --wait database redis",
    "queue:down": "docker compose down",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @noma/web dev",
    "dev:api": "pnpm --filter @noma/api dev",
    "dev:worker": "pnpm --filter @noma/worker dev",
    "start:web": "pnpm --filter @noma/web start",
    "start:api": "pnpm --filter @noma/api start",
    "start:worker": "pnpm --filter @noma/worker start",
    "smoke:runtimes": "pnpm build && node scripts/smoke-runtimes.mjs",
    "check": "pnpm workspace:validate && pnpm runtimes:validate && pnpm env:validate && pnpm db:validate && pnpm queue:foundation:validate && pnpm lint && pnpm typecheck && pnpm build",
    "clean": "turbo run clean && node scripts/clean-workspace.mjs"
  },
  "devDependencies": {
    "tsx": "4.22.3",
    "turbo": "2.9.14",
    "typescript": "6.0.3"
  }
}
